#pragma endian little
#pragma description Simple-Scada Script Container (.ssc)

import std.string;


// ============================================================
// Тип скрипта
// ============================================================
//
// Хранится как u16 Little Endian.
//
// Известные значения установлены экспериментально.
// ============================================================

enum ScriptType : u16 {
    Universal       = 0x0001,
    ProjectStart    = 0x0101,
    Periodic        = 0x0501,
    SqlDone         = 0x0702,
    OnLogin         = 0x0406,
    OnValueChanged  = 0x0805,
    TableCellEvent  = 0x0F09,
    GlobalModule    = 0x100A,
    SqlError        = 0x0B10
};


// ============================================================
// Скрипт. Это общая структура для любых типов скриптов. 
// ============================================================

struct Script {

    // --------------------------------------------------------
    // Глобальный индекс скрипта
    //
    // Скрипты используют общее пространство индексов. После удаления индекс повторно не используется.
    // --------------------------------------------------------

    u32 index;

    // --------------------------------------------------------
    // Неизвестное поле. 
    // Во всех исследованных файлах: 00 00 00 00 
    // Т.к. это древовидная структура, вероятнее всего это уровень вложенности. По аналогии с другими структурами ниже
    // --------------------------------------------------------

    u32 unknown_01;

    // --------------------------------------------------------
    // Имя скрипта
    //
    // Формат:
    //
    //     u32       количество UTF-16 символов
    //     UTF-16LE  символы имени
    // --------------------------------------------------------

    std::string::SizedString16<u32> name;

    // --------------------------------------------------------
    // Тип скрипта / события
    // --------------------------------------------------------

    ScriptType script_type;

    // --------------------------------------------------------
    // Позиция скрипта в объединённом исходном коде
    // Simple-Scada перед компиляцией объединяет обычные скрипты в один общий исходный текст.
    // Для первого скрипта: source_line = 2
    // Для следующего: next.source_line =current.source_line + current.line_count + 2
    // Для Global Module: source_line = 0
    // Вероятно Global Module компилируются отдельно.
    // --------------------------------------------------------

    u32 source_line;

    // --------------------------------------------------------
    // Периодичность выполнения скрипта
    // --------------------------------------------------------

    u16 execution_period;

    // --------------------------------------------------------
    // Выполнить сразу при запуске проекта
    //     0 = нет
    //     1 = да
    // --------------------------------------------------------

    u8 execute_on_start;

    // --------------------------------------------------------
    // Ссылка на результат компиляции
    // При ошибке компиляции: compiled_script_ref = 0
    // При ручном создании нового скрипта можно ставить 0.
    // После удаления старой компиляции Simple-Scada заполняет поле самостоятельно при перекомпиляции.
    // --------------------------------------------------------

    s32 compiled_script_ref;

    // --------------------------------------------------------
    // Включение скрипта в компиляцию
    //     0 = исключён
    //     1 = включён
    // --------------------------------------------------------

    u8 include_in_compilation;

    // --------------------------------------------------------
    // Количество переменных, привязанных к скрипту
    // --------------------------------------------------------

    u32 binding_count;

    // --------------------------------------------------------
    // ID привязанных переменных
    // --------------------------------------------------------

    s64 bindings[binding_count];

    // --------------------------------------------------------
    // Количество строк исходного кода
    // --------------------------------------------------------

    u32 line_count;

    // --------------------------------------------------------
    // Исходный код
    // Каждая строка:
    //     u32       количество UTF-16 символов
    //     UTF-16LE  содержимое строки
    // Пробелы в конце строк сохраняются.
    // --------------------------------------------------------

    std::string::SizedString16<u32> lines[line_count];
};

// ============================================================
// Группа скриптов. Это общая структура для любой созданной группы
// ============================================================
// Группы имеют рекурсивную структуру
// ============================================================

struct ScriptGroup {

    // --------------------------------------------------------
    // Имя группы
    // Формат:
    //     u32   длина строки в байтах
    //     UTF-8 содержимое строки
    // --------------------------------------------------------

    std::string::SizedString<u32> name;

    // --------------------------------------------------------
    // Количество вложенных групп
    // --------------------------------------------------------

    u32 child_group_count;

    // --------------------------------------------------------
    // Вложенные группы. Структура рекурсивная.
    // --------------------------------------------------------

    ScriptGroup child_groups[child_group_count];

    // --------------------------------------------------------
    // Количество скриптов непосредственно в этой группе
    // Скрипты вложенных групп сюда не входят.
    // --------------------------------------------------------

    u32 script_count;

    // --------------------------------------------------------
    // Скрипты непосредственно текущей группы
    // --------------------------------------------------------

    Script scripts[script_count];
};


// ============================================================
// Файл SSC
// ============================================================

struct SscFile {

    // --------------------------------------------------------
    // Счётчик индексов скриптов
    // Это не обязательно фактическое количествосуществующих скриптов. После удаления скрипта значение не уменьшается.
    // --------------------------------------------------------

    u32 total_script_count;

    // --------------------------------------------------------
    // Неизвестное поле заголовка. Всегда 0.
    // Т.к. это древовидная структура, вероятнее всего это уровень вложенности. По аналогии с другими структурами ниже
    // --------------------------------------------------------

    u32 unknown_header;


    // --------------------------------------------------------
    // Путь
    //
    // В исследованных файлах:
    //     ..\
    // Формат:
    //
    //     u32   длина строки в байтах
    //     bytes содержимое строки
    // --------------------------------------------------------

    std::string::SizedString<u32> path;

    // ========================================================
    // Группы верхнего уровня
    // Вложенные группы находятся рекурсивно внутри
    // ScriptGroup.child_groups.
    // ========================================================

    u32 group_count;

    ScriptGroup groups[group_count];

    // ========================================================
    // Скрипты вне групп
    // ========================================================

    u32 root_script_count;

    Script root_scripts[root_script_count];
};


// ============================================================
// Корень файла
// ============================================================

SscFile ssc @ 0x00;